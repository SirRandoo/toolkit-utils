<?xml version="1.0" encoding="utf-8"?>


<!--
XML patches for the mod "Vanilla Factions Expanded - Vikings."

These patches target various hediffs added by the mod to prevent 
said hediffs from being healed by ToolkitUtils' healing events.

The current list of hediffs patched includes: 
• VFEV_BleedrateCrypto_5
• VFEV_BleedrateCrypto_10
• VFEV_BleedrateCrypto_20
-->

<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Vikings</li>
        </mods>
        <match Class="PatchOperationSequence">
            <success>Always</success>
            <operations>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/HediffDef[defName="VFEV_BleedrateCrypto_5" or defName="VFEV_BleedrateCrypto_10" or defName="VFEV_BleedrateCrypto_20"]
                    </xpath>
                    <value>
                        <li class="SirRandoo.ToolkitUtils.HealExtension">
                            <ShouldHeal>false</ShouldHeal>
                        </li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
