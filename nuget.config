<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <packageSources>
        <clear/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
        <add key="sirrandoo.com" value="https://git.sirrandoo.com/api/packages/sirrandoo/nuget/index.json"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
        <packageSource key="sirrandoo.com">
            <package pattern="SirRandoo.*"/>
            <package pattern="com.sirrandoo.*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
