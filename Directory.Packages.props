<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Logging packages -->
    <ItemGroup>
        <PackageVersion Include="NLog" Version="6.0.3"/>
    </ItemGroup>

    <!-- Utility packages -->
    <ItemGroup>
        <PackageVersion Include="FormatWith" Version="3.0.1"/>
        <PackageVersion Include="ConcurrentHashSet" Version="1.3.0"/>
    </ItemGroup>
    
    <!-- Http packages -->
    <ItemGroup>
        <PackageVersion Include="RestSharp" Version="106.15.0" />
    </ItemGroup>

    <!-- Reference packages -->
    <ItemGroup>
        <PackageVersion Include="Krafs.Rimworld.Ref" Version="1.6.4566"/>
        <PackageVersion Include="com.sirrandoo.toolkitcore.ref" Version="25.8.16"/>
        <PackageVersion Include="com.sirrandoo.twitchtoolkit.ref" Version="25.8.16"/>
    </ItemGroup>

    <!-- Reflection packages -->
    <ItemGroup>
        <PackageVersion Include="Lib.Harmony" Version="2.4.1"/>
        <PackageVersion Include="Mono.Reflection" Version="2.0.0"/>
    </ItemGroup>

    <!-- Source generation packages -->
    <ItemGroup>
        <PackageVersion Include="PolySharp" Version="1.15.0"/>
        <PackageVersion Include="NetEscapades.EnumGenerators" Version="1.0.0-beta14"/>
    </ItemGroup>

    <!-- Data format packages -->
    <ItemGroup>
        <PackageVersion Include="Samboy063.Tomlet" Version="6.1.0"/>
        <PackageVersion Include="System.Text.Json" Version="9.0.0"/>
    </ItemGroup>
</Project>